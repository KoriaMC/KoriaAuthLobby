  "width": 172,
  "height": 214,
  "anchor": "CENTER",
  "scaleMode": "ADAPT",
  "referenceWidth": 520,
  "referenceHeight": 320,
  "background": "#B0000000",
  "blur": true,
  "closeOnEscape": false,
  "openSound": "random.pop",
  "closeSound": "",
