      "submitOnEnter": true,
      "scale": 0.75,
      "color": "#00000000",
      "borderColor": "#00000000",
      "focusBorderColor": "#00000000",
      "borderWidth": 0,
      "textColor": "#FFFFF1C8",
      "hintColor": "#80E6C895",
      "actions": [
        "command: %var_auth_commande% login %local_auth_mdp%"
