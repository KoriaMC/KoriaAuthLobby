      "regionHeight": 549,
      "smooth": true
    },
    {
      "type": "RECT",
      "id": "bouton_clic",
      "x": 38,
      "y": 131,
      "width": 96,
      "height": 21,
      "color": "#00000000",
      "hoverColor": "#30FFF1C8",
      "radius": 4,
      "clickSound": true,
      "actions": [
        "command: %var_auth_commande% login %local_auth_mdp%"
      ]
    },
    {
      "type": "TEXT",
      "id": "oublie",
      "x": 56,
      "y": 156,
      "width": 60,
      "height": 6,
